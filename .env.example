# Supabase — create a project at https://supabase.com/dashboard
# Run migrations from supabase/migrations against your project (Supabase CLI or SQL editor).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: E2E / RLS integration tests (never commit real passwords)
# E2E_USER_EMAIL=
# E2E_USER_PASSWORD=
# E2E_OWNER_EMAIL=
# E2E_OWNER_PASSWORD=
# E2E_RECIPIENT_EMAIL=
# E2E_RECIPIENT_PASSWORD=
# E2E_STRANGER_EMAIL=
# E2E_STRANGER_PASSWORD=
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=

# Optional: only for local Supabase CLI (not used by the Next.js app)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
